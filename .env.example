# Copy this file to .env.local and fill in real values.
# All variables below are optional — each feature only activates if its
# variable is set, and fails safely (no false success) if it's not.

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=

# Campaign inquiry email delivery (Resend — https://resend.com).
# Powers /api/campaign-inquiry and /api/campaign-lead. Server-only —
# never prefix these with NEXT_PUBLIC_. Without all three set, campaign
# submissions are validated but NOT emailed (the endpoint returns an
# error rather than a false success). Does not affect /api/contact.
RESEND_API_KEY=
CAMPAIGN_INQUIRY_TO_EMAIL=
CAMPAIGN_FROM_EMAIL=

# Marked Minds OS (Airtable — https://airtable.com). Intake Queue is the
# system of record for every lead generated through the site; email above
# is the notification, this is the database. Currently powers only
# /api/campaign-inquiry (Black2School) — see docs/AIRTABLE_CRM_SCHEMA.md
# for the full base schema. Without all three set, submissions still email
# fine but are NOT saved to Airtable (logged server-side as a non-fatal
# error — a lead already emailed is never reported as failed just because
# Airtable is unreachable).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_INTAKE_TABLE=
